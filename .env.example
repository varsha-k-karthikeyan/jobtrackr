# Template for the backend's environment variables. Committed on purpose: placeholders only, never real values.
#
# Use it in one of three ways (all git-ignored, so your real values never reach the repository):
#   - copy it to jobtrackr-backend/.env.properties: Spring reads that file at startup (same KEY=value format)
#   - copy it to .env and select that file in an IntelliJ run configuration (see README, "The JWT secret")
#   - set the variables in your shell or in the run configuration's "Environment variables" field
# A real environment variable always wins over the file.

# Required. Signs the login tokens; any random string of at least 32 characters.
# Generate one in PowerShell:
#   $bytes = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# Changing it later logs everyone out.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Optional. Browser origins allowed to call the API, comma-separated. Default: http://localhost:4200
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional. Set to true wherever the API is served over HTTPS (the refresh cookie gets the Secure flag). Default: false
# REFRESH_COOKIE_SECURE=false

# Optional. Time zone in which "today" is decided for follow-up notifications. Default: Asia/Kolkata
# NOTIFICATIONS_ZONE=Asia/Kolkata

# Optional. Background jobs (the nightly token cleanup and the reminder emails). Set to false to run without them. Default: true
# SCHEDULING_ENABLED=true

# Optional. When expired refresh tokens and reset links are cleaned up (Spring cron, India time). Default: 03:30 daily
# TOKEN_CLEANUP_CRON=0 30 3 * * *

# Optional. How often the reminder-email job checks for due emails (morning digest, interview starting soon).
# A check interval, not a send time: the digest still goes out from 08:00. Default: every minute
# REMINDER_EMAILS_CRON=0 * * * * *

# Optional. Outgoing mail (password-reset links and reminder emails). The defaults send to the local Mailpit container from
# docker-compose.yml, which delivers nothing (inbox: http://localhost:8025). For real delivery, set these to a
# provider's SMTP settings; the password belongs in your local file or the environment, never in a committed file.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=JobTrackr <no-reply@jobtrackr.local>

# Optional. Frontend URL used in the reset link and the reminder emails (never taken from the request). Default: http://localhost:4200
# APP_URL=http://localhost:4200

# ---------- Docker (docker-compose.yml, Dockerfiles) ----------
# Compose reads a .env file next to docker-compose.yml, so copying this file to .env at the monorepo root
# configures `docker compose --profile full up --build`. JWT_SECRET above is required for the full stack.

# Optional. Host port for PostgreSQL. Change it if a local PostgreSQL service already uses 5432. Default: 5432
# POSTGRES_HOST_PORT=5432

# Optional. Port the backend listens on inside its container or on a hosting platform. Default: 8080
# PORT=8080

# Optional. JVM flags for the backend image. Default: -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# Optional. Where the frontend image's nginx forwards /api/. Default: http://backend:8080 (the compose service)
# BACKEND_URL=http://backend:8080
