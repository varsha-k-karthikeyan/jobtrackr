# The only .gitignore in the repository. Patterns without a leading slash match at any depth,
# so "target/" covers jobtrackr-backend/target/ and "node_modules/" will cover the Angular app too.

# Maven build output
target/
.mvn/wrapper/maven-wrapper.jar

# npm packages (root commit tooling and the Angular app)
node_modules/

# Angular build output and caches (jobtrackr-frontend)
dist/
.angular/
out-tsc/
coverage/
.sass-cache/
__screenshots__/
npm-debug.log

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/

# Secrets and local environment files (JWT_SECRET etc. must never be committed).
# ".env.*" also covers jobtrackr-backend/.env.properties. The example holds placeholders only, so it is kept.
.env
.env.*
!.env.example

# Logs
*.log

# OS files
Thumbs.db
.DS_Store
